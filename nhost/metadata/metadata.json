{
  "version": 3,
  "sources": [
    {
      "name": "default",
      "kind": "postgres",
      "tables": [
        {
          "table": {"schema": "public", "name": "organizations"},
          "array_relationships": [
            {"name": "members", "using": {"foreign_key_constraint_on": {"column": "org_id", "table": {"schema": "public", "name": "org_members"}}}},
            {"name": "workflows", "using": {"foreign_key_constraint_on": {"column": "org_id", "table": {"schema": "public", "name": "workflows"}}}}
          ],
          "select_permissions": [{"role": "user", "permission": {"columns": ["id", "name", "quota_limit", "quota_used", "period_started_at", "period_ends_at"], "filter": {"members": {"user_id": {"_eq": "X-Hasura-User-Id"}}}}}]
        },
        {
          "table": {"schema": "public", "name": "org_members"},
          "object_relationships": [{"name": "organization", "using": {"foreign_key_constraint_on": "org_id"}}],
          "select_permissions": [{"role": "user", "permission": {"columns": ["id", "org_id", "user_id", "role", "created_at"], "filter": {"user_id": {"_eq": "X-Hasura-User-Id"}}}}],
          "insert_permissions": [{"role": "user", "permission": {"columns": ["org_id", "user_id", "role"], "check": {"organization": {"members": {"user_id": {"_eq": "X-Hasura-User-Id"}, "role": {"_eq": "owner"}}}}}}],
          "update_permissions": [{"role": "user", "permission": {"columns": ["role"], "filter": {"organization": {"members": {"user_id": {"_eq": "X-Hasura-User-Id"}, "role": {"_eq": "owner"}}}}, "check": {"organization": {"members": {"user_id": {"_eq": "X-Hasura-User-Id"}, "role": {"_eq": "owner"}}}}}}],
          "delete_permissions": [{"role": "user", "permission": {"filter": {"organization": {"members": {"user_id": {"_eq": "X-Hasura-User-Id"}, "role": {"_eq": "owner"}}}}}}]
        },
        {
          "table": {"schema": "public", "name": "workflows"},
          "object_relationships": [{"name": "organization", "using": {"foreign_key_constraint_on": "org_id"}}],
          "array_relationships": [
            {"name": "steps", "using": {"foreign_key_constraint_on": {"column": "workflow_id", "table": {"schema": "public", "name": "workflow_steps"}}}},
            {"name": "triggers", "using": {"foreign_key_constraint_on": {"column": "workflow_id", "table": {"schema": "public", "name": "workflow_triggers"}}}},
            {"name": "runs", "using": {"foreign_key_constraint_on": {"column": "workflow_id", "table": {"schema": "public", "name": "workflow_runs"}}}}
          ],
          "select_permissions": [{"role": "user", "permission": {"columns": ["id", "org_id", "name", "description", "active", "created_at", "updated_at"], "filter": {"organization": {"members": {"user_id": {"_eq": "X-Hasura-User-Id"}}}}}}],
          "insert_permissions": [{"role": "user", "permission": {"columns": ["org_id", "name", "description", "active"], "check": {"organization": {"members": {"user_id": {"_eq": "X-Hasura-User-Id"}, "role": {"_in": ["owner", "editor"]}}}}}}],
          "update_permissions": [{"role": "user", "permission": {"columns": ["name", "description", "active"], "filter": {"organization": {"members": {"user_id": {"_eq": "X-Hasura-User-Id"}, "role": {"_in": ["owner", "editor"]}}}}, "check": {"organization": {"members": {"user_id": {"_eq": "X-Hasura-User-Id"}, "role": {"_in": ["owner", "editor"]}}}}}}],
          "delete_permissions": [{"role": "user", "permission": {"filter": {"organization": {"members": {"user_id": {"_eq": "X-Hasura-User-Id"}, "role": {"_in": ["owner", "editor"]}}}}}}]
        },
        {
          "table": {"schema": "public", "name": "workflow_steps"},
          "object_relationships": [{"name": "workflow", "using": {"foreign_key_constraint_on": "workflow_id"}}],
          "select_permissions": [{"role": "user", "permission": {"columns": ["id", "workflow_id", "position", "type", "config", "created_at", "updated_at"], "filter": {"workflow": {"organization": {"members": {"user_id": {"_eq": "X-Hasura-User-Id"}}}}}}}],
          "insert_permissions": [{"role": "user", "permission": {"columns": ["workflow_id", "position", "type", "config"], "check": {"workflow": {"organization": {"members": {"user_id": {"_eq": "X-Hasura-User-Id"}, "role": {"_in": ["owner", "editor"]}}}}}}}],
          "update_permissions": [{"role": "user", "permission": {"columns": ["position", "type", "config"], "filter": {"workflow": {"organization": {"members": {"user_id": {"_eq": "X-Hasura-User-Id"}, "role": {"_in": ["owner", "editor"]}}}}}}}],
          "delete_permissions": [{"role": "user", "permission": {"filter": {"workflow": {"organization": {"members": {"user_id": {"_eq": "X-Hasura-User-Id"}, "role": {"_in": ["owner", "editor"]}}}}}}}]
        },
        {
          "table": {"schema": "public", "name": "workflow_triggers"},
          "object_relationships": [{"name": "workflow", "using": {"foreign_key_constraint_on": "workflow_id"}}],
          "select_permissions": [{"role": "user", "permission": {"columns": ["id", "workflow_id", "type", "config", "enabled"], "filter": {"workflow": {"organization": {"members": {"user_id": {"_eq": "X-Hasura-User-Id"}}}}}}}],
          "insert_permissions": [{"role": "user", "permission": {"columns": ["workflow_id", "type", "config", "enabled"], "check": {"workflow": {"organization": {"members": {"user_id": {"_eq": "X-Hasura-User-Id"}, "role": {"_in": ["owner", "editor"]}}}}}}}],
          "update_permissions": [{"role": "user", "permission": {"columns": ["type", "config", "enabled"], "filter": {"workflow": {"organization": {"members": {"user_id": {"_eq": "X-Hasura-User-Id"}, "role": {"_in": ["owner", "editor"]}}}}}}}],
          "delete_permissions": [{"role": "user", "permission": {"filter": {"workflow": {"organization": {"members": {"user_id": {"_eq": "X-Hasura-User-Id"}, "role": {"_in": ["owner", "editor"]}}}}}}}]
        },
        {
          "table": {"schema": "public", "name": "workflow_runs"},
          "object_relationships": [{"name": "workflow", "using": {"foreign_key_constraint_on": "workflow_id"}}],
          "array_relationships": [{"name": "step_runs", "using": {"foreign_key_constraint_on": {"column": "workflow_run_id", "table": {"schema": "public", "name": "step_runs"}}}}],
          "select_permissions": [{"role": "user", "permission": {"columns": ["id", "workflow_id", "trigger_type", "status", "initiated_by", "trigger_input", "error", "started_at", "completed_at"], "filter": {"workflow": {"organization": {"members": {"user_id": {"_eq": "X-Hasura-User-Id"}}}}}}}]
        },
        {
          "table": {"schema": "public", "name": "step_runs"},
          "object_relationships": [{"name": "workflow_run", "using": {"foreign_key_constraint_on": "workflow_run_id"}}, {"name": "workflow_step", "using": {"foreign_key_constraint_on": "workflow_step_id"}}],
          "select_permissions": [{"role": "user", "permission": {"columns": ["id", "workflow_run_id", "workflow_step_id", "status", "input", "output", "error", "attempt_count", "approved_by", "approved_at", "started_at", "completed_at"], "filter": {"workflow_run": {"workflow": {"organization": {"members": {"user_id": {"_eq": "X-Hasura-User-Id"}}}}}}}}]
        },
        {
          "table": {"schema": "public", "name": "organization_monthly_usage"},
          "select_permissions": [{"role": "user", "permission": {"columns": ["org_id", "name", "used", "limit", "remaining", "period_started_at", "period_ends_at"], "filter": {"org_id": {"_is_null": false}}}}]
        }
      ]
    }
  ],
  "custom_types": {"objects": [{"name": "TriggerWorkflowRunOutput", "fields": [{"name": "run_id", "type": {"named_type": "uuid"}}, {"name": "status", "type": {"named_type": "String"}}]}, {"name": "SaveWorkflowOutput", "fields": [{"name": "workflow_id", "type": {"named_type": "uuid"}}]}]},
  "actions": [
    {"name": "triggerWorkflowRun", "definition": {"kind": "synchronous", "handler": "{{NHOST_FUNCTIONS_URL}}/triggerWorkflowRun", "type": "mutation", "arguments": [{"name": "workflow_id", "type": "uuid!"}, {"name": "trigger_context", "type": "jsonb"}], "output_type": "TriggerWorkflowRunOutput!"}},
    {"name": "approveStep", "definition": {"kind": "synchronous", "handler": "{{NHOST_FUNCTIONS_URL}}/approveStep", "type": "mutation", "arguments": [{"name": "workflow_run_id", "type": "uuid!"}, {"name": "step_run_id", "type": "uuid!"}, {"name": "decision", "type": "String!"}], "output_type": "TriggerWorkflowRunOutput!"}},
    {"name": "webhookStartWorkflow", "definition": {"kind": "synchronous", "handler": "{{NHOST_FUNCTIONS_URL}}/webhookStartWorkflow", "type": "mutation", "arguments": [{"name": "public_id", "type": "String!"}, {"name": "payload", "type": "jsonb"}], "output_type": "TriggerWorkflowRunOutput!"}},
    {"name": "saveWorkflow", "definition": {"kind": "synchronous", "handler": "{{NHOST_FUNCTIONS_URL}}/saveWorkflow", "type": "mutation", "arguments": [{"name": "workflow", "type": "jsonb!"}], "output_type": "SaveWorkflowOutput!"}}
  ],
  "cron_triggers": [{"name": "workflow-scheduler", "webhook_url": "{{NHOST_FUNCTIONS_URL}}/scheduledWorkflowStart", "schedule": "* * * * *", "payload": {}}],
  "event_triggers": [{"name": "watched-orders-workflow", "table": {"schema": "public", "name": "watched_orders"}, "webhook": "{{NHOST_FUNCTIONS_URL}}/databaseEventStart", "insert": true, "update": true, "delete": false, "retry_conf": {"num_retries": 3, "interval_sec": 10, "timeout_sec": 60}}],
  "functions": [{"function": {"schema": "public", "name": "reserve_org_quota"}, "configuration": {"exposed_as": "mutation"}}]
}
